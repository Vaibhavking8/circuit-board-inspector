      "min_size": 1
    },
    {
      "id": "tiny_1px",
      "description": "Very small normalised box (0.1%) in a 100x100 image — minimum size of 1 px enforced",
      "image_width": 100,
      "image_height": 100,
      "norm_box": [0.5, 0.5, 0.001, 0.001],
      "pixel_box": [50, 50, 1, 1],
      "min_size": 1
    },
    {
      "id": "high_res",
