{
  "version": 1,
  "description": "Shared test vectors for coordinate-utils.js and coordinates.py. All pixel_box values computed by running coordinates.py with min_size=1.",
  "vectors": [
    {
      "id": "centre_box",
      "description": "5% box centred in a 1000x800 image — straightforward centre case",
      "image_width": 1000,
      "image_height": 800,
      "norm_box": [0.475, 0.475, 0.05, 0.05],
      "pixel_box": [475, 380, 50, 40],
      "min_size": 1
    },
    {
      "id": "demo_exact",
      "description": "10% box exactly centred in a 1000x800 image — the canonical demo case",
      "image_width": 1000,
      "image_height": 800,
