      "pixel_box": [500, 400, 100, 80],
      "min_size": 1
    },
    {
      "id": "origin_box",
      "description": "10% box at the top-left corner of a 640x480 image",
      "image_width": 640,
      "image_height": 480,
      "norm_box": [0.0, 0.0, 0.1, 0.1],
      "pixel_box": [0, 0, 64, 48],
      "min_size": 1
    },
    {
      "id": "border_box_right",
      "description": "Box that starts at 95% from left and extends 10% — clamped at right edge (640-608=32 px wide)",
